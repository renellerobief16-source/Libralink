          <mxGeometry x="80" y="470" width="40" height="80" as="geometry" />
        </mxCell>

        <!-- Partner-School Librarian -->
        <mxCell id="actor_partnerlib" value="Partner-School&lt;br&gt;Librarian" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#68C5F7;strokeColor=#000000;strokeWidth=1.5;fontStyle=1;fontSize=13;" vertex="1" parent="uc_root_1">
