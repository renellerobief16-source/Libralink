        <mxCell id="uc_confirm_avail" value="Confirm Resource&lt;br&gt;Availability" style="ellipse;whiteSpace=wrap;html=1;fillColor=#68C5F7;strokeColor=#000000;strokeWidth=1.5;fontStyle=1;fontSize=12;" vertex="1" parent="uc_root_1">
          <mxGeometry x="640" y="740" width="180" height="60" as="geometry" />
