          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="erd_conn3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=1.5;strokeColor=#059669;endArrow=ERmany;startArrow=ERone;" edge="1" parent="erd_1" source="tbl_schools" target="tbl_books">
