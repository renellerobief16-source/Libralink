        <mxCell id="uc_root_1" parent="uc_root_0" />

        <!-- Title -->
        <mxCell id="uc_title" value="&lt;b&gt;&lt;font style=&quot;font-size: 22px; color: #0F172A;&quot;&gt;LibraLink - UML Use Case Diagram&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px; color: #475569;&quot;&gt;Actors, Associations, &amp;lt;&amp;lt;Include&amp;gt;&amp;gt;, and &amp;lt;&amp;lt;Extend&amp;gt;&amp;gt; Relationships&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="uc_root_1">
          <mxGeometry x="40" y="25" width="600" height="40" as="geometry" />
